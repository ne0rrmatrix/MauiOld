<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
				xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
				xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages"
				xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
				xmlns:viewModels="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Views"
				xmlns:converters="clr-namespace:CommunityToolkit.Maui.Sample.Converters"
				x:TypeArguments="viewModels:MediaElementDrmViewModel"
				x:DataType="viewModels:MediaElementDrmViewModel"
				x:Class="CommunityToolkit.Maui.Sample.Pages.Views.MediaElementDrmPage"
				Title="MediaElement DRM">

	<pages:BasePage.Resources>
		<converters:SecondsToStringConverter x:Key="SecondsToStringConverter" />
	</pages:BasePage.Resources>

	<ScrollView>
		<Grid RowSpacing="8" Padding="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="220" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Media Player: Axinom Clear Test Stream (no DRM) for immediate playback -->
			<toolkit:MediaElement
				WidthRequest="600"
				HeightRequest="300"
				x:Name="MediaElement"
				ShouldAutoPlay="True"
				ShouldShowPlaybackControls="True"
				MediaEnded="OnMediaEnded"
				MediaFailed="OnMediaFailed"
				MediaOpened="OnMediaOpened"
				PositionChanged="OnPositionChanged"
				StateChanged="OnStateChanged"
				SeekCompleted="OnSeekCompleted"/>

			<!-- Status Bar -->
			<HorizontalStackLayout Grid.Row="1" Spacing="8">
				<Label x:Name="StatusLabel" VerticalOptions="Center">
					<Label.FormattedText>
						<FormattedString>
							<Span Text="State: " FontAttributes="Bold" />
							<Span x:Name="StateText" Text="None" />
							<Span Text="  |  " />
							<Span Text="Dim: " FontAttributes="Bold" />
							<Span x:Name="DimensionsText" Text="0x0" />
						</FormattedString>
					</Label.FormattedText>
				</Label>
			</HorizontalStackLayout>

			<!-- Transport Controls -->
			<Grid Grid.Row="2" Padding="0,4" ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
				<Button Grid.Column="0" Text="Play" Clicked="OnPlayClicked" />
				<Button Grid.Column="1" Text="Pause" Clicked="OnPauseClicked" />
				<Button Grid.Column="2" Text="Stop" Clicked="OnStopClicked" />
				<Button Grid.Column="3" Text="Mute" Clicked="OnMuteClicked" />
			</Grid>

			<!-- Position Slider -->
			<Slider
				x:Name="PositionSlider"
				Grid.Row="3"
				MinimumTrackColor="Gray"
				DragStarted="Slider_DragStarted"
				DragCompleted="Slider_DragCompleted"/>

			<Grid Grid.Row="4">
				<Label HorizontalOptions="Start" x:DataType="toolkit:MediaElement"
					   Text="{Binding Position, Source={x:Reference MediaElement}, Converter={StaticResource SecondsToStringConverter}}" />
				<Label HorizontalOptions="End" HorizontalTextAlignment="End" x:DataType="toolkit:MediaElement"
					   Text="{Binding Duration, Source={x:Reference MediaElement}, Converter={StaticResource SecondsToStringConverter}}" />
			</Grid>

			<!-- DRM Configuration Section Header -->
			<Label Grid.Row="5" Text="DRM Configuration" FontSize="18" FontAttributes="Bold"
				   Padding="0,12,0,4" />

			<!-- Test Vector Selection -->
			<Grid Grid.Row="6" ColumnDefinitions="120,*" ColumnSpacing="8" Padding="0,4">
				<Label Grid.Column="0" Text="Test Vector:" VerticalOptions="Center" />
				<HorizontalStackLayout Grid.Column="1" Spacing="8">
					<Picker x:Name="TestVectorPicker" SelectedIndexChanged="OnTestVectorChanged" WidthRequest="280">
						<Picker.ItemsSource>
							<x:Array Type="{x:Type x:String}">
								<x:String>CMAF H.264 Single Key</x:String>
								<x:String>CMAF H.264 Multi Key</x:String>
								<x:String>CMAF H.265 Single Key</x:String>
								<x:String>CMAF H.265 Multi Key</x:String>
								<x:String>DASH H.264 Single Key</x:String>
								<x:String>DASH H.264 Multi Key</x:String>
								<x:String>DASH H.265 Single Key</x:String>
								<x:String>DASH H.265 Multi Key</x:String>
								<x:String>HLS H.264 Single Key</x:String>
								<x:String>HLS H.264 Multi Key</x:String>
								<x:String>HLS H.265 Single Key</x:String>
								<x:String>HLS H.265 Multi Key</x:String>
						<x:String>Clear DASH (no DRM)</x:String>
							</x:Array>
						</Picker.ItemsSource>
					</Picker>
				</HorizontalStackLayout>
			</Grid>

			<!-- DRM Scheme -->
			<Grid Grid.Row="7" ColumnDefinitions="120,*" ColumnSpacing="8" Padding="0,4">
				<Label Grid.Column="0" Text="DRM Scheme:" VerticalOptions="Center" />
				<HorizontalStackLayout Grid.Column="1" Spacing="8">
					<Picker x:Name="DrmSchemePicker" SelectedIndexChanged="OnDrmSchemeChanged" WidthRequest="160">
						<Picker.ItemsSource>
							<x:Array Type="{x:Type x:String}">
								<x:String>Widevine</x:String>
								<x:String>PlayReady</x:String>
								<x:String>FairPlay</x:String>
							</x:Array>
						</Picker.ItemsSource>
					</Picker>
					<Label x:Name="PlatformHintLabel" Text="" VerticalOptions="Center"
						   FontSize="12" TextColor="Gray" />
				</HorizontalStackLayout>
			</Grid>

			<!-- Source URL -->
			<Grid Grid.Row="8" ColumnDefinitions="120,*" ColumnSpacing="8" Padding="0,4">
				<Label Grid.Column="0" Text="Source URL:" VerticalOptions="Center" />
				<Entry x:Name="SourceUrlEntry" Grid.Column="1"
					   Text="https://media.axprod.net/TestVectors/Cmaf/protected_1080p_h264_cbcs/manifest.mpd" />
			</Grid>

			<!-- License Server URL: Auto-populated based on DRM scheme -->
			<Grid Grid.Row="9" ColumnDefinitions="120,*" ColumnSpacing="8" Padding="0,4">
				<Label Grid.Column="0" Text="License Server:" VerticalOptions="Center" />
				<Entry x:Name="LicenseServerEntry" Grid.Column="1"
					   Text="https://drm-playready-licensing.axprod.net/AcquireLicense" />
			</Grid>

			<!-- License Request Headers -->
			<VerticalStackLayout Grid.Row="10" Spacing="4" Padding="0,8,0,0">
				<Label Text="License Request Headers:" FontAttributes="Bold" Padding="0,0,0,4" />
				<Grid ColumnDefinitions="*,*,40" ColumnSpacing="5">
					<Entry x:Name="HeaderNameEntry" Grid.Column="0" Text="X-AxDRM-Message" Placeholder="Header name" />
					<Entry x:Name="HeaderValueEntry" Grid.Column="1" Placeholder="Header value" />
				</Grid>
				<Label x:Name="DrmHeadersSummaryLabel" Text="No headers defined" FontSize="12" TextColor="Gray" />
				<Button Text="Clear Headers" Clicked="ClearDrmHeadersClicked" HeightRequest="36" FontSize="12" />
			</VerticalStackLayout>

			<!-- DRM Security Level + Load -->
			<Grid Grid.Row="11" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="0,12,0,0">
				<HorizontalStackLayout Grid.Column="0" Spacing="8">
					<Picker x:Name="DrmSecurityLevelPicker" WidthRequest="180">
						<Picker.ItemsSource>
							<x:Array Type="{x:Type x:String}">
								<x:String>Software DRM</x:String>
								<x:String>Hardware DRM</x:String>
							</x:Array>
						</Picker.ItemsSource>
					</Picker>
					<Label x:Name="DrmSecurityHintLabel" Text="(default)" VerticalOptions="Center"
						   FontSize="12" TextColor="Gray" />
				</HorizontalStackLayout>
				<Button Grid.Column="1" Text="Load DRM Source" Clicked="OnLoadDrmSourceClicked"
						BackgroundColor="{StaticResource Primary}" TextColor="White"
						FontAttributes="Bold" />
			</Grid>
		</Grid>
	</ScrollView>
</pages:BasePage>
