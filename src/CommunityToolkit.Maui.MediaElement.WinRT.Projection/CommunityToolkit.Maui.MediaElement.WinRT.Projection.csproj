<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <CsWinRTEnabled>true</CsWinRTEnabled>
    <CsWinRTIncludes>CommunityToolkit.Maui.Media.WinRT</CsWinRTIncludes>
    <CsWinRTGeneratedFilesDir>$(OutDir)</CsWinRTGeneratedFilesDir>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CsWinRT1028</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Feed the component winmd to cswinrt.exe directly. A plain <Reference>
         is rejected by ResolveAssemblyReference (MSB3246: "PE image does not
         have metadata"), which starves the projection of its input. -->
    <CsWinRTInputs Include="..\CommunityToolkit.Maui.MediaElement.WinRT\Communit.8A2D5F3B\x64\$(Configuration)\Merged\CommunityToolkit.Maui.Media.WinRT.winmd" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CommunityToolkit.Maui.MediaElement.WinRT\x64\$(Configuration)\CommunityToolkit.Maui.MediaElement.WinRT\CommunityToolkit.Maui.Media.WinRT.dll" Link="CommunityToolkit.Maui.Media.WinRT.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\CommunityToolkit.Maui.MediaElement.WinRT\x64\$(Configuration)\CommunityToolkit.Maui.MediaElement.WinRT\CommunityToolkit.Maui.Media.WinRT.pri" Link="CommunityToolkit.Maui.Media.WinRT.pri" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
