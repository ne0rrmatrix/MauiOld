<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(NetVersion);$(NetVersion)-android;$(NetVersion)-ios;$(NetVersion)-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(NetVersion)-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeTizenTargetFrameworks)' == 'true'">$(TargetFrameworks);$(NetVersion)-tizen</TargetFrameworks>
    <SingleProject>true</SingleProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(NetVersion)' == 'net11.0'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(NetVersion)' != 'net11.0'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    <RootNamespace>CommunityToolkit.Maui</RootNamespace>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>

    <DisableTextColorToGenerator>true</DisableTextColorToGenerator>
  </PropertyGroup>

  <PropertyGroup>
    <GitInfoReportImportance>high</GitInfoReportImportance>
    <PackageId>CommunityToolkit.Maui.MediaElement</PackageId>
    <Summary>MediaElement is a view for playing video and audio in your .NET MAUI app.</Summary>
    <Authors>Microsoft</Authors>
    <Owners>Microsoft</Owners>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>CommunityToolkit.Maui ($(NetVersion))</Product>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CommunityToolkit/Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CommunityToolkit/Maui</RepositoryUrl>
    <PackageReleaseNotes>See https://github.com/CommunityToolkit/Maui/releases</PackageReleaseNotes>
    <DefineConstants>$(DefineConstants);</DefineConstants>
    <UseFullSemVerForNuGet>false</UseFullSemVerForNuGet>
    <Title>.NET MAUI MediaElement</Title>
    <Description>MediaElement is a view for playing video and audio in your .NET MAUI app.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <Product>$(AssemblyName) ($(TargetFramework))</Product>
    <Version>1.0.0-pre1</Version>
    <PackageVersion>$(Version)$(VersionSuffix)</PackageVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>dotnet,maui,toolkit,kit,communitytoolkit,dotnetcommunitytoolkit,mediaelement,mediaplayer,audio,video</PackageTags>
    <Configurations>Debug;Release</Configurations>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\build\nuget.png" PackagePath="icon.png" Pack="true" />
    <None Include="ReadMe.txt" pack="true" PackagePath="." />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CommunityToolkit.Maui.MediaElement.Analyzers\bin\$(Configuration)\netstandard2.0\CommunityToolkit.Maui.MediaElement.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\CommunityToolkit.Maui.MediaElement.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\CommunityToolkit.Maui.MediaElement.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\CommunityToolkit.Maui.MediaElement.SourceGenerators\bin\$(Configuration)\netstandard2.0\CommunityToolkit.Maui.MediaElement.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Common" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Rtsp" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.8.0" />

    <!--include the textureview.xml needed for creating textureview in android-->
    <Folder Include="Platforms\Android\Resources\layout\" />
    <AndroidResource Include="Platforms\Android\Resources\layout\textureview.xml" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" Condition=" '$(Configuration)'=='Release' " PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ResourceDictionary.windows.xaml">
      <LogicalName>ResourceDictionary.windows.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Native PlayReady backend (Drm/PlayReadyNativePlayer.windows.cs P/Invokes into the DLL this builds). NOT wired
    as a <ProjectReference>: the .NET SDK's own MSBuild engine (what `dotnet build`/`dotnet pack` uses) cannot
    resolve $(VCTargetsPath) at all — merely evaluating a vcxproj under it fails with MSB4278, even with
    ReferenceOutputAssembly="false", before any target of ours runs. Genuine Visual Studio C++ build support only
    exists in devenv's own MSBuild.exe, so the native build below shells out to that MSBuild.exe as an external
    process (located via vswhere.exe) for each platform explicitly — a vcxproj's Platform axis (x64/ARM64) doesn't
    line up with this csproj's AnyCPU managed build in any case. The vcxproj can still be opened/built directly in
    the Visual Studio IDE; it's simply not part of this csproj's own MSBuild graph.
  -->
  <Target Name="LocateVsMSBuildForPlayReadyNative" BeforeTargets="Build" Condition="$(TargetFramework.Contains('-windows')) and $([MSBuild]::IsOSPlatform('windows')) and '$(VsMSBuildExeForPlayReadyNative)' == ''">
    <Exec Command="&quot;%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -prerelease -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find &quot;MSBuild\**\Bin\MSBuild.exe&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="WarnAndContinue" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_PlayReadyNativeVsMsBuildCandidates" />
    </Exec>
    <PropertyGroup>
      <VsMSBuildExeForPlayReadyNative>%(_PlayReadyNativeVsMsBuildCandidates.Identity)</VsMSBuildExeForPlayReadyNative>
    </PropertyGroup>
    <Warning Text="Visual Studio's MSBuild with the C++ workload (Microsoft.VisualStudio.Component.VC.Tools.x86.x64) was not found — FluentGpu.PlayReady.Native.dll will not be built, and native PlayReady playback will report itself unavailable at runtime. Install the &quot;Desktop development with C++&quot; workload to build it."
             Condition="'$(VsMSBuildExeForPlayReadyNative)' == ''" />
  </Target>

  <Target Name="BuildPlayReadyNativeDll" BeforeTargets="Build" DependsOnTargets="LocateVsMSBuildForPlayReadyNative"
          Condition="$(TargetFramework.Contains('-windows')) and $([MSBuild]::IsOSPlatform('windows')) and '$(VsMSBuildExeForPlayReadyNative)' != ''">
    <Exec Command="&quot;$(VsMSBuildExeForPlayReadyNative)&quot; &quot;Native\PlayReadyNative\PlayReadyNative.vcxproj&quot; /p:Configuration=Release /p:Platform=x64 /v:minimal /nologo" />
    <Exec Command="&quot;$(VsMSBuildExeForPlayReadyNative)&quot; &quot;Native\PlayReadyNative\PlayReadyNative.vcxproj&quot; /p:Configuration=Release /p:Platform=ARM64 /v:minimal /nologo" />
  </Target>

  <!--
    Packaging a multi-targeted project's TFM-specific content cannot be done via a plain top-level/target-scoped
    <None Pack="true"> item: NuGet's pack orchestration builds each TargetFramework as a separate inner-build
    invocation and only asks that inner build for items via the well-known TargetsForTfmSpecificContentInPackage
    hook — a BeforeTargets="_GetPackageFiles" guess (tried first) silently produced a nupkg with no runtimes/
    folder, because _GetPackageFiles runs in a context where this target never fired. TfmSpecificPackageFile is
    the SDK-sanctioned item type for exactly this.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddPlayReadyNativeDllToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddPlayReadyNativeDllToPackage" DependsOnTargets="BuildPlayReadyNativeDll">
    <ItemGroup>
      <TfmSpecificPackageFile Include="Native\PlayReadyNative\bin\x64\Release\FluentGpu.PlayReady.Native.dll"
                              Condition="Exists('Native\PlayReadyNative\bin\x64\Release\FluentGpu.PlayReady.Native.dll')">
        <PackagePath>runtimes/win-x64/native/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="Native\PlayReadyNative\bin\ARM64\Release\FluentGpu.PlayReady.Native.dll"
                              Condition="Exists('Native\PlayReadyNative\bin\ARM64\Release\FluentGpu.PlayReady.Native.dll')">
        <PackagePath>runtimes/win-arm64/native/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <!--
    Separately, for F5/local-run (not packed): copy the current machine's architecture of the native DLL next to
    the build output so a debug session can load it without consuming the nupkg. Adding this inside a target
    (rather than as a top-level ItemGroup) is required — top-level items are evaluated before
    BuildPlayReadyNativeDll has produced the DLL, so an Exists() check there would always see a stale/missing file.
  -->
  <Target Name="AddPlayReadyNativeDllToOutputDir" DependsOnTargets="BuildPlayReadyNativeDll"
          BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems"
          Condition="$(TargetFramework.Contains('-windows')) and $([MSBuild]::IsOSPlatform('windows'))">
    <ItemGroup>
      <None Include="Native\PlayReadyNative\bin\ARM64\Release\FluentGpu.PlayReady.Native.dll"
            Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64' and Exists('Native\PlayReadyNative\bin\ARM64\Release\FluentGpu.PlayReady.Native.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>FluentGpu.PlayReady.Native.dll</Link>
        <Visible>false</Visible>
      </None>
      <None Include="Native\PlayReadyNative\bin\x64\Release\FluentGpu.PlayReady.Native.dll"
            Condition="'$(PROCESSOR_ARCHITECTURE)' != 'ARM64' and Exists('Native\PlayReadyNative\bin\x64\Release\FluentGpu.PlayReady.Native.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>FluentGpu.PlayReady.Native.dll</Link>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

</Project>